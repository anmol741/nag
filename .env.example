# Absolute public URL this site is deployed at — used for social share
# links, canonical/OG metadata, and the sitemap. Falls back to Netlify's own
# URL env var, then to http://localhost:3000 in local development if unset
# (see lib/site-url.ts).
NEXT_PUBLIC_SITE_URL=https://taupe-buttercream-c55e75.netlify.app

# After the main domain launches, change this to:
# NEXT_PUBLIC_SITE_URL=https://nagsbeautysupply.com

# --- Phase 2: customer accounts (server-only — never NEXT_PUBLIC_*) ---
# See the Phase 2 report ("Manual configuration report") for exact setup
# steps. None of these are set in this project; until they are, login,
# registration, and account/order data all respond with an honest
# "not connected yet" — nothing is faked.

# Required to issue/verify the session cookie at all. A random 32+ byte
# value, e.g. `openssl rand -base64 32`. Rotating it logs everyone out.
# SESSION_SECRET=

# The verified WordPress customer-login endpoint, once one exists (e.g. a
# JWT auth plugin's token URL). Absent = login stays disabled.
# WORDPRESS_AUTH_ENDPOINT=

# WooCommerce REST API v3 admin credentials (WooCommerce > Settings >
# Advanced > REST API — Read/Write). Used server-only, to look up a
# customer's OWN profile/orders by the ID from their verified session —
# never sent to the browser, never accepted from it either. Absent =
# account/order data and registration all stay disabled.
# WOOCOMMERCE_CONSUMER_KEY=
# WOOCOMMERCE_CONSUMER_SECRET=

# Already used elsewhere in this project (lib/woocommerce.ts) for the
# public, unauthenticated Store API — reused here for the admin API too.
# Defaults to https://nagsbeautysupply.com if unset.
# WOOCOMMERCE_STORE_URL=https://nagsbeautysupply.com
