# Copy to .env.local for local development. NEVER commit real values —
# .gitignore already excludes every .env* file except this example.
# On Netlify: Site configuration → Environment variables.

# Absolute public URL of the storefront — canonical/OG metadata, sitemap,
# and the primary allowed origin for the CSRF check (lib/server/csrf.ts).
NEXT_PUBLIC_SITE_URL=https://taupe-buttercream-c55e75.netlify.app
# After the main domain launches, change this to:
# NEXT_PUBLIC_SITE_URL=https://nagsbeautysupply.com

# Extra exact origins allowed to POST to the API (comma-separated), e.g. a
# custom domain served by the same Netlify site. Arbitrary origins are never accepted.
# ALLOWED_ORIGINS=https://www.nagsbeautysupply.com
# Netlify branch/deploy URLs of the SAME *.netlify.app site are accepted by
# default (fixes the live 403). Set to false to disable.
# ALLOW_NETLIFY_DEPLOY_ORIGINS=true

# ---------------------------------------------------------------------------
# Server-only secrets — never prefix these with NEXT_PUBLIC_.
# ---------------------------------------------------------------------------

# Signs the HttpOnly session cookie. 32+ random bytes: `openssl rand -base64 32`.
# Rotating it logs everyone out.
SESSION_SECRET=

# Session length in hours (default 72, max 720).
# SESSION_TTL_HOURS=72

# Shared secret for the WordPress "Nag's Headless Bridge" plugin. Must be
# IDENTICAL to NAG_BRIDGE_SECRET in WordPress wp-config.php. 64 hex chars:
# `openssl rand -hex 32`.
WORDPRESS_BRIDGE_SECRET=

# WordPress base URL hosting the bridge plugin (defaults to WOOCOMMERCE_STORE_URL).
# WORDPRESS_BRIDGE_URL=https://nagsbeautysupply.com

# WooCommerce REST API v3 keys (WooCommerce → Settings → Advanced → REST API,
# Read/Write). Used server-only for the customer's own profile, addresses and
# order history.
WOOCOMMERCE_CONSUMER_KEY=
WOOCOMMERCE_CONSUMER_SECRET=

# Store base URL (public Store API + admin API). Defaults to https://nagsbeautysupply.com.
# WOOCOMMERCE_STORE_URL=https://nagsbeautysupply.com

# Course payments by e-Transfer (/enroll/pay). OFF unless exactly "true".
# The deposit amount is set in WordPress (WooCommerce → Settings → Nag's Beauty).
# COURSE_ONLINE_PAYMENTS_ENABLED=false
